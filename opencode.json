{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FHNW LiteLLM",
      "options": {
        "baseURL": "https://litellm.engines.aisl.science/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna", "limit": { "context": 128000, "output": 16000 } },
        "azure_ai/gpt-oss-120b": { "name": "GPT-OSS 120B (open-weight)", "limit": { "context": 128000, "output": 16000 } },
        "azure_ai/mistral-large-3": { "name": "Mistral Large 3", "limit": { "context": 128000, "output": 16000 } },
        "azure_ai/claude-haiku-5-5": { "name": "Claude Haiku 5.5", "limit": { "context": 128000, "output": 16000 } }
      }
    }
  },
  "permission": { "edit": "ask", "bash": "ask" },
  "mcp": {
    "baissue": { "type": "remote", "url": "https://gitmcp.io/AIaSDev/BAIssue", "enabled": true }
  }
}