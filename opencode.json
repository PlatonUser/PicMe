{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FHNW LiteLLM",
      "options": {
        "baseURL": "https://litellm.engines.aisl.science/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "azure_ai/kimi-k2.7-code": { "name": "Kimi K2.7 Code", "limit": { "context": 128000, "output": 16000 } },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna", "limit": { "context": 128000, "output": 16000 } },
        "azure_ai/gpt-5.4-mini": { "name": "GPT-5.4 mini", "limit": { "context": 128000, "output": 16000 } }
      }
    }
  },
  "permission": { "edit": "ask", "bash": "ask" },
  "mcp": {
    "baissue": { "type": "remote", "url": "https://gitmcp.io/AIaSDev/BAIssue", "enabled": true }
  }
}